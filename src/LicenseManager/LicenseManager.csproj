<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>LicenseManager</AssemblyName>
    <PackageId>LicenseManager.Sdk</PackageId>
    <OutputType>Library</OutputType>
    <Authors>LicenseManager</Authors>
    <Company>LicenseManager</Company>
    <AssemblyTitle>LicenseManager SDK</AssemblyTitle>
    <Description>C# client for the LicenseManager API: products, policies, customers, licenses, machines and releases.</Description>
    <Copyright>LicenseManager</Copyright>
    <RootNamespace>LicenseManager</RootNamespace>
    <Version>0.1.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\LicenseManager.xml</DocumentationFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/licenseman/licensemanager-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/licenseman/licensemanager-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>licensemanager;licensing;license-keys;api;sdk</PackageTags>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <PackageProjectUrl>https://licensemanager.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.1.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
